---
import BaseHead from '../components/BaseHead.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<div class="page-wrapper">
			
			<aside class="sidebar">
				<h2 class="site-title"><a href="/">Huy Le</a></h2>

				<nav class="explorer">
					<h3>Explorer</h3>
					<ul>
						<li><a href="/">› Home</a></li>
						<li><a href="/about">› About</a></li>
						<li><a href="/blog">› Blog</a></li>
					</ul>
				</nav>
			</aside>

			<main class="content">
				<article class="index-page">
					<header class="page-header">
						<h1 class="page-title">index</h1>
						<p class="metadata">May 13, 2026 • 1 min read</p>
					</header>

					<div class="banner">
						<img src="/banner.jpg" alt="Scenery" onerror="this.style.display='none'"/>
					</div>

					<div class="page-body">
						<p>Student at HCMUS. Has questionable media tastes.</p>
						<hr />

						<div class="links-container">
							<div class="link-group">
								<h3>Media</h3>
								<ul class="flat-list">
									<li><a href="https://www.albumoftheyear.org/user/heleme/" target="_blank">AOTY</a> <span>Music 🎧</span></li>
									<li><a href="https://myanimelist.net/profile/heleme69" target="_blank">MAL</a> <span>Anime & Manga 🍿</span></li>
									<li><a href="https://letterboxd.com/heleme67/" target="_blank">Letterboxd</a> <span>Movies 🎬</span></li>
								</ul>
							</div>

							<div class="link-group">
								<h3>Study</h3>
								<ul class="flat-list">
									<li><a href="https://heleme69.github.io/quartz/" target="_blank">Obsidian</a> <span>Note 🧠</span></li>
									<li><a href="https://github.com/heleme69" target="_blank">GitHub</a> <span>Source Code 💻</span></li>
								</ul>
							</div>
						</div>
					</div>

					<footer class="quartz-footer">
						<p>© 2026 heleme69<br/>
						<a href="https://github.com/heleme69">GitHub</a></p>
					</footer>
				</article>
			</main>
			
		</div>
	</body>
</html>

<style>
	/* Layout Structure */
	.page-wrapper {
		display: flex;
		max-width: 1200px;
		margin: 0 auto;
		padding: 4rem 2rem;
		gap: 6rem;
	}

	.sidebar {
		width: 250px;
		flex-shrink: 0;
	}

	.content {
		flex-grow: 1;
		max-width: 750px; 
	}

	/* Sidebar Styling */
	.site-title {
		margin-top: 0;
		margin-bottom: 2rem;
	}

	.site-title a {
		color: var(--text-heading); 
		font-size: var(--size-h4);
		font-weight: 700;
	}

	.explorer h3 {
		font-size: 0.85rem;
		color: var(--text-muted);
		margin-bottom: 0.5rem;
		margin-top: 0;
	}

	.explorer ul {
		list-style: none;
		padding: 0;
		margin: 0;
	}

	.explorer li {
		margin-bottom: 0.3rem;
	}

	.explorer a {
		font-size: 0.95rem;
		color: var(--link-color);
	}

	/* Page Content Styling */
	.page-header {
		margin-bottom: 1.5rem;
	}

	.page-title {
		margin: 0;
	}

	.metadata {
		color: var(--text-muted);
		font-size: 0.85rem;
		margin: 0.2rem 0 0 0;
		text-align: left;
	}

	.banner img {
		width: 100%;
		border-radius: 4px;
		display: block;
		margin-bottom: var(--space-4);
		object-fit: cover;
	}

	.links-container {
		display: flex;
		gap: 5rem;
		margin-top: 2rem;
	}

	.link-group h3 {
		font-size: 0.85rem;
		color: var(--text-muted);
		text-transform: uppercase;
		letter-spacing: 0.05em;
		margin-bottom: 0.8rem;
		margin-top: 0;
	}

	.flat-list {
		list-style: none;
		padding: 0;
		margin: 0;
	}

	.flat-list li {
		display: flex;
		justify-content: space-between;
		align-items: center;
		padding: 0.4rem 0;
		width: 200px; 
		margin-bottom: 0;
	}

	.flat-list li span {
		font-size: 0.85rem;
		color: var(--text-muted);
	}

	.quartz-footer {
		margin-top: 4rem;
		padding-top: 2rem;
		border-top: 1px solid var(--border-color);
	}

	.quartz-footer p {
		color: var(--text-muted);
		font-size: 0.85rem;
		line-height: 1.8;
		text-align: left;
		margin: 0;
	}

	.quartz-footer a {
		margin-right: 1rem;
	}

	@media (max-width: 850px) {
		.page-wrapper {
			flex-direction: column;
			gap: 3rem;
			padding: 2rem 1.5rem;
		}
		.sidebar {
			width: 100%;
		}
		.links-container {
			flex-direction: column;
			gap: 2rem;
		}
		.flat-list li {
			width: 100%;
		}
	}
</style>