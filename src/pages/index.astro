---
// We are importing a simpler layout used by the blog template
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import MediaLinks from '../components/MediaLinks.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main>
			<h1>Huy <span class="text-gradient">Le</span></h1>
			<p class="subtitle">
				Student at <strong>HCMUS</strong>. 
				Has questionable media tastes.
			</p>

			<MediaLinks />

		</main>
		<Footer />
	</body>
</html>

<style>
	main {
		margin: auto;
		padding: 1rem;
		width: 800px;
		max-width: calc(100% - 2rem);
		color: #333; /* Making it dark text for now to match the default white theme */
		line-height: 1.6;
	}
	h1 {
		font-size: 3rem;
		font-weight: 700;
		line-height: 1;
		margin-bottom: 0.5em;
	}
	.text-gradient {
		background-image: linear-gradient(45deg, #00abff, #7c3aed);
		-webkit-background-clip: text;
		-webkit-text-fill-color: transparent;
		background-size: 400%;
		background-position: 0%;
	}
	.subtitle {
		margin-bottom: 2rem;
		border-bottom: 1px solid #eee;
		padding-bottom: 1rem;
		color: #666;
	}
</style>