---
const mediaLinks = [
  { name: 'AOTY', desc: 'Music 🎧', url: 'https://www.albumoftheyear.org/user/heleme/', color: '#ffbd03' },
  { name: 'MAL', desc: 'Anime & Manga 🍿', url: 'https://myanimelist.net/profile/heleme69', color: '#2e51a2' },
  { name: 'Letterboxd', desc: 'Movies 🎬', url: 'https://letterboxd.com/heleme67/', color: '#00e054' },
];

const studyLinks = [
  { name: 'Obsidian', desc: 'Note 🧠', url: 'https://heleme69.github.io/quartz/', color: '#7c3aed' },
];
---

<div class="two-col">
  <div class="col">
    <h3 class="col-title">Media</h3>
    <div class="shelf">
      {mediaLinks.map(link => (
        <a href={link.url} class="card" target="_blank" style={`--accent: ${link.color}`}>
          <div class="text-group">
            <span class="title">{link.name}</span>
            <span class="info">{link.desc}</span>
          </div>
          <span class="arrow">→</span>
        </a>
      ))}
    </div>
  </div>

  <div class="col">
    <h3 class="col-title">Study</h3>
    <div class="shelf">
      {studyLinks.map(link => (
        <a href={link.url} class="card" target="_blank" style={`--accent: ${link.color}`}>
          <div class="text-group">
            <span class="title">{link.name}</span>
            <span class="info">{link.desc}</span>
          </div>
          <span class="arrow">→</span>
        </a>
      ))}
    </div>
  </div>
</div>

<style>
  .two-col {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2rem;
    margin: 2rem 0;
  }
  @media (max-width: 600px) {
    .two-col {
      grid-template-columns: 1fr;
    }
  }
  .col-title {
    font-size: 0.85rem;
    font-weight: 700;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: #71717a;
    margin-bottom: 0.75rem;
  }
  .shelf {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .card {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 1rem 1.5rem;
    background: #18181b;
    border: 1px solid #27272a;
    border-left: 6px solid var(--accent);
    color: #fafafa;
    text-decoration: none;
    border-radius: 8px;
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  }
  .card:hover {
    transform: scale(1.02) translateX(8px);
    background: #27272a;
    box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.3);
  }
  .title {
    display: block;
    font-weight: 800;
    font-size: 1.2rem;
    letter-spacing: 1px;
    color: var(--accent);
  }
  .info {
    font-size: 0.9rem;
    color: #a1a1aa;
  }
  .arrow {
    font-size: 1.5rem;
    opacity: 0;
    transition: opacity 0.3s;
  }
  .card:hover .arrow {
    opacity: 1;
  }
</style>